header
  nav
    h1.logo IdPAM
    span »
    h2.pageTitle= pageTitle

  if (user)
    nav.menu
      span <
      ul
        li 
          a(href="/", class=(pageTitle=='home' ? 'active' : '')) home
        li 
          a(href="/identities", class=(pageTitle=='identities' ? 'active' : '')) identities
        li 
          a(href="/roles", class=(pageTitle=='roles' ? 'active' : '')) roles
      span >
    .userMenu
      figure
       img(src="")
      a(href="/")
        span= user.nickName
        span @
        span= user.domain
        span /
        span= user.credentialName
      span |
      form(action='/logout' method='post')
        input(type='hidden' name='csrfToken' value=csrfToken)
        button.logout(type='submit') logout
