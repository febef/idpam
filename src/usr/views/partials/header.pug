header
  nav(aria-label='Page identity')
    h1.logo IdPAM
    span »
    h2.pageTitle= pageTitle

  if (user)
    nav.menu(aria-label='Primary')
      span <
      ul
        li 
          a(href="/", class=(pageTitle=='home' ? 'active' : '') aria-current=(pageTitle=='home' ? 'page' : null)) home
        li 
          a(href="/identities", class=(pageTitle=='identities' ? 'active' : '') aria-current=(pageTitle=='identities' ? 'page' : null)) identities
        li 
          a(href="/roles", class=(pageTitle=='roles' ? 'active' : '') aria-current=(pageTitle=='roles' ? 'page' : null)) roles
      span >
    .userMenu
      a(href="/")
        span= user.nickName
        span @
        span= user.domain
        span /
        span= user.credentialName
      span |
      form(action='/logout' method='post')
        input(type='hidden' name='csrfToken' value=csrfToken)
        button.logout(type='submit') logout
