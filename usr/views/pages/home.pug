
extends ../layouts/main.pug
include ../mixin/home.pug
include ../mixin/editableobject.pug

block main

  section.main

    section.user.m-1
      +user(user)

    section.box.m-1(data-target=`metadata:${id.metadatas.id}`)
      header.boxTitle
        h3 metadata

      +editableObject(id.metadatas, '', '')

    section.credentials
      header
        h3 Credentials

      for credentials, credentialType in id.credentials.toJSON()
        +credentialTypeSection(credentialType, credentials[credentialType])

          for credential, key in id.credentials[credentialType]
            article.box(data-target=`${credentialType.split('').slice(0,-1).join('')}:${credential.id}`)
              +editableObject(credential, key, '')
              fieldset.flex-rigth
                button.min-info(data-verb='delete') (delete)
              //`credential.${credentialType}`)
          else
            span.min-info no hay credenciales
