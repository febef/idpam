# Isolated local lab image. See docs/demo-contract.md before any public exposure.
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS dependencies

WORKDIR /app
COPY src/package.json src/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS runtime

WORKDIR /app

# Package managers are build-time tooling. Excluding npm/corepack from the
# runtime removes an unnecessary attack surface and their transitive packages.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpx

COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node src/package.json src/package-lock.json ./
COPY --chown=node:node src/bin ./bin
COPY --chown=node:node src/etc ./etc
COPY --chown=node:node src/lib ./lib
COPY --chown=node:node src/usr ./usr

ENV NODE_ENV=production
USER node
EXPOSE 3000
CMD ["node", "bin/demo.js"]
