# Isolated local lab image. See docs/demo-contract.md before any public exposure.
FROM node:22-bookworm-slim

WORKDIR /app
COPY src/package.json src/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY src/bin ./bin
COPY src/etc ./etc
COPY src/lib ./lib
COPY src/usr ./usr

ENV NODE_ENV=production
USER node
EXPOSE 3000
CMD ["node", "bin/demo.js"]
